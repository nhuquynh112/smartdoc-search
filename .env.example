# Copy to .env and replace both password placeholders with the same local password.
# Use letters and digits for the first setup to avoid URL escaping.
POSTGRES_DB=smartdoc
POSTGRES_USER=smartdoc_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433

# Python runs on the host; inside Docker the database service hostname would be db.
DATABASE_URL=postgresql://smartdoc_app:CHANGE_ME@localhost:5433/smartdoc
STORAGE_ROOT=storage
